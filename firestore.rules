rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Site owner's account, checked by email claim on the auth token
    // (present by default for email/password sign-in). Lets the in-app
    // moderation panel read and approve/reject pending letters and comments
    // without needing the Firebase console or an Admin SDK key.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'elenisigoulaki44@gmail.com';
    }

    // Users: private profile data. Only the account owner can read or write
    // their own doc (name, DOB, country, moods, tasks, favourites, etc.)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Notifications: only the owner can read/mark them read. Create is
      // open to any signed-in user (not just the owner) because liking or
      // commenting on someone else's letter needs to write a notification
      // into *their* subcollection — the tradeoff is a signed-in user could
      // spam annoying notifications, but they can't read/alter anyone else's.
      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // Community: one shared stats doc (community/stats). Any signed-in
    // client can bump the counter fields (writing a letter, liking,
    // commenting, completing tasks), but nothing else — specialAchievement
    // is set by you directly in the console, and the doc itself is seeded
    // once by hand rather than created by a client.
    match /community/{docId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalLettersWritten', 'weekLettersWritten',
          'totalTipsGiven', 'weekTipsGiven',
          'totalSupportGiven', 'weekSupportGiven',
          'totalOtherComments', 'weekOtherComments',
          'totalLikesGiven',
          'totalLettersRead', 'weekLettersRead',
          'totalDailyCompletions', 'totalWeeklyCompletions',
          'tapestryProgress', 'weekStartDate'
        ]);
      allow create: if false;
      allow delete: if false;
    }

    // Letters: public feed only shows status == "approved". Authors can
    // always read their own letter regardless of status (so "My Letters"
    // can show pending/rejected ones back to them).
    // New letters must be created as "pending" — clients can never set
    // status to "approved" themselves; that's done by you, signed into the
    // Firebase console (console access bypasses these rules entirely).
    match /letters/{letterId} {
      allow read: if resource.data.status == 'approved'
                  || (request.auth != null && request.auth.uid == resource.data.authorUid)
                  || isAdmin();

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorUid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.likedByUids == [];

      // A client can either toggle their own like (comment counts are
      // derived live from the comments subcollection, so there's nothing
      // else to touch there), or, if they're the site owner, flip the
      // status field to approve/reject a pending letter.
      allow update: if request.auth != null &&
                    (
                      (resource.data.status == 'approved' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedByUids']))
                      || (isAdmin() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                    );

      allow delete: if false;

      // Comments: same pending/approved gate, plus the admin exception so
      // the moderation panel can see and approve/reject pending comments
      // on anyone's letter.
      match /comments/{commentId} {
        allow read: if resource.data.status == 'approved'
                    || (request.auth != null && request.auth.uid == resource.data.authorUid)
                    || isAdmin();

        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorUid
                      && request.resource.data.status == 'pending';

        allow update: if isAdmin() &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

        allow delete: if false;
      }
    }

    // Daily rating check-ins: one doc per user per day (id "{uid}_{date}"),
    // shown as pins on the globe once approved. Same pending/approved gate
    // as letters/comments — the owner can create or resubmit their own
    // doc, but only ever back to "pending"; only the admin can approve it.
    match /checkins/{checkinId} {
      allow read: if resource.data.status == 'approved'
                  || (request.auth != null && request.auth.uid == resource.data.uid)
                  || isAdmin();

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.status == 'pending';

      // The owner can resubmit their own doc (e.g. editing today's
      // comment before it's reviewed), but only ever back to "pending" —
      // only the admin can flip status to approved/rejected.
      allow update: if request.auth != null &&
                    (
                      (request.auth.uid == resource.data.uid &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.status == 'pending')
                      || (isAdmin() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                    );

      allow delete: if false;
    }
  }
}
